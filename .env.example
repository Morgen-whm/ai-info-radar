# Local mode: demo or live
DATA_MODE=demo

# TikHub (Los Angeles deployment uses api.tikhub.io)
TIKHUB_BASE_URL=https://api.tikhub.io
# Local development only. Do not set this localhost URL in Sites production.
RSS_PROXY_URL=http://127.0.0.1:4317/rss
# Set to external when Linux.do is delivered by the GitHub scheduled workflow.
LINUXDO_SCHEDULE_MODE=direct
# Set to external when IDCFlare is delivered by the GitHub scheduled workflow.
IDCFLARE_SCHEDULE_MODE=direct
# Optional server fallback for scheduled collection
TIKHUB_TOKEN=
# Encrypts each browser's personal TikHub key (minimum 24 characters)
TIKHUB_KEY_ENCRYPTION_SECRET=

# DeepSeek OpenAI-compatible API (summaries are optional; one-click knowledge rewrite requires it)
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-pro

# WeChat Official Account drafts (server-side only; NEVER use NEXT_PUBLIC_*)
# The account must have draft/material API permission and an outbound IP allowlist.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=
# Optional exact trusted HTTPS image hosts, comma-separated. No wildcard/IP/private hosts.
WECHAT_IMAGE_HOSTS=

# GitHub Star growth collection. Optional locally, strongly recommended online.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=

# Protect /api/internal/cron in production
CRON_SECRET=

# Protect server-to-server weekly report APIs (minimum 32 characters)
WEEKLY_API_KEY=

# Feishu publishing (server-side only)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Choose one target: a Wiki URL/node token (recommended) or a Docx URL/token.
# Wiki publishing resolves its underlying Docx automatically; requires wiki:node:read.
FEISHU_DAILY_WIKI_NODE_TOKEN=
# Dedicated Docx token from https://tenant.feishu.cn/docx/<this-token> (fallback).
# The radar rebuilds this document by date. Do not mix unrelated manual notes into it.
FEISHU_DAILY_DOCUMENT_ID=
FEISHU_DAILY_DOCUMENT_TITLE=AI 情报雷达 · 每日精选
# Legacy per-article destinations. Not used by the daily master document mode.
FEISHU_WIKI_SPACE_ID=
FEISHU_WIKI_PARENT_NODE_TOKEN=
FEISHU_FOLDER_TOKEN=
# Example: your-team.feishu.cn, used to build clickable document URLs.
FEISHU_TENANT_DOMAIN=
